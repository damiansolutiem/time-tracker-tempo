{
  "name": "time-tracker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @time-tracker/desktop dev",
    "dev:desktop": "VITE_APP_FLAVOR=development TEMPO_BUILD_FLAVOR=development pnpm --filter @time-tracker/desktop tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @time-tracker/desktop tauri build",
    "package:macos:production": "pnpm --filter @time-tracker/desktop package:macos:production",
    "package:macos:development": "pnpm --filter @time-tracker/desktop package:macos:development",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.38.0"
  }
}
